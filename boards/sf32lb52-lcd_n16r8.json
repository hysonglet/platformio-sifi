{
  "platform": "sifli",
  "build": {
    "board": "sf32lb52-lcd_n16r8",
    "core": "hcpu",
    "mcu": "sf32lb52x",
    "cpu": "cortex-m33",
    "f_cpu": "120000000L",
    "flash_size": 16,
    "ram_size": 524,
    "framework": "sifli-sdk"
  },
  "upload": {
    "maximum_size": 7340032,
    "maximum_flash_size": 7340032,
    "maximum_ram_size": 536576,
    "protocol": "uart",
    "protocols": [
      "uart",
      "jlink",
      "cmsis-dap"
    ]
  },
  "debug": {
    "jlink_device": "SF32LB52X_NOR",
    "openocd_target": "sf32lb52x",
    "default_tools": [
      "cmsis-dap"
    ],
    "tools": {}
  },
  "frameworks": [
    "sifli-sdk"
  ],
  "name": "SiFli SF32LB52x LCD DevKit (N16R8)",
  "vendor": "SiFli",
  "url": "https://docs.sifli.com/projects/sdk/latest/sf32lb52x/index.html"
}
